{
  // name(!): The name of game displayed on frontend.
  
  // url.base(?): Prefix of other URLs.
  // url.play(?): Destination of the "play game" button.
  // url.banner(?): URL of the game branding banner.
  // url.banner_bg(?): URL of game branding banner background.
  
  // path(!): Filesystem relative path to game dir, for backend only and hidden from frontend.
  // storage_namespace(!): localStorage key namespace. It is assumed that {namespace}:progress stores the game progress.
  // level_namespace(?): If present, level IDs in this game will be displayed as {namespace}-{id}.
  // cheat_flags(?): Available localStorage cheat flags stored at {namespace}:{flag_name}.
  // created(?): Introduction date of the game.
  // extras.level_desc(?): User-friendly description of newly-added levels.
  // extras.modified(?): Last modified date of extra levels. Used to display the "new level" badge.

  // level_fields_overlay (?): Entries overlayed onto LevelItemData.allKeys in frontend.

  // accept_legacy_import(?): Allow legacy unspecified single-game data to be imported into the game.
  //                          Can be safely disabled if the game came out after the legacy exporter got taken down.
  
